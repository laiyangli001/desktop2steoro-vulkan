#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer RgbBuffer {
    float rgb[];
};

layout(set = 0, binding = 1, std430) readonly buffer DepthBuffer {
    float depth[];
};

layout(set = 0, binding = 2, std430) writeonly buffer LeftBuffer {
    float left_eye[];
};

layout(set = 0, binding = 3, std430) writeonly buffer RightBuffer {
    float right_eye[];
};

layout(set = 0, binding = 4, std430) writeonly buffer MaskBuffer {
    float occlusion_mask[];
};

layout(push_constant) uniform StereoParams {
    uint width;
    uint height;
    float depth_strength;
    float max_disparity_px;
    float convergence;
    float edge_threshold;
    float fill_strength;
    uint fill_radius;
    uint mask_feather_radius;
    uint symmetric;
} params;

uint pixel_count() {
    return params.width * params.height;
}

int clamp_x(int x) {
    return clamp(x, 0, int(params.width) - 1);
}

int clamp_y(int y) {
    return clamp(y, 0, int(params.height) - 1);
}

uint pixel_index(int x, int y) {
    return uint(clamp_y(y)) * params.width + uint(clamp_x(x));
}

float depth_at(int x, int y) {
    return clamp(depth[pixel_index(x, y)], 0.0, 1.0);
}

float shift_at(int x, int y) {
    float response = depth_at(x, y) - params.convergence;
    return -response * max(params.depth_strength, 0.0) * params.max_disparity_px * 0.5;
}

float max_shift_magnitude() {
    float scale = max(params.depth_strength, 0.0) * params.max_disparity_px * 0.5;
    return max(max(abs(params.convergence * scale), abs((1.0 - params.convergence) * scale)), 1.0e-6);
}

float reflect_coordinate(float coordinate, float extent) {
    if (extent <= 1.0) {
        return 0.0;
    }
    float period = 2.0 * (extent - 1.0);
    float value = mod(coordinate, period);
    if (value < 0.0) {
        value += period;
    }
    return value <= extent - 1.0 ? value : period - value;
}

vec3 rgb_at(uint pixel) {
    uint plane = pixel_count();
    return vec3(
        rgb[pixel],
        rgb[plane + pixel],
        rgb[2 * plane + pixel]
    );
}

vec3 sample_rgb(float x, float y) {
    float reflected_x = reflect_coordinate(x, float(params.width));
    float reflected_y = reflect_coordinate(y, float(params.height));
    int x0 = int(floor(reflected_x));
    int y0 = int(floor(reflected_y));
    int x1 = min(x0 + 1, int(params.width) - 1);
    int y1 = min(y0 + 1, int(params.height) - 1);
    float tx = reflected_x - float(x0);
    float ty = reflected_y - float(y0);
    vec3 top = mix(rgb_at(pixel_index(x0, y0)), rgb_at(pixel_index(x1, y0)), tx);
    vec3 bottom = mix(rgb_at(pixel_index(x0, y1)), rgb_at(pixel_index(x1, y1)), tx);
    return mix(top, bottom, ty);
}

vec3 warp_at(int x, int y, float eye_sign) {
    return sample_rgb(float(x) + shift_at(x, y) * eye_sign, float(y));
}

float edge_at(int x, int y) {
    int right_x = min(x + 1, int(params.width) - 1);
    int down_y = min(y + 1, int(params.height) - 1);
    float center_depth = depth_at(x, y);
    float depth_edge = abs(depth_at(right_x, y) - center_depth)
        + abs(depth_at(x, down_y) - center_depth);
    float shift_edge = abs(abs(shift_at(right_x, y)) - abs(shift_at(x, y)))
        + abs(abs(shift_at(x, down_y)) - abs(shift_at(x, y)));
    return (depth_edge > params.edge_threshold || shift_edge / max_shift_magnitude() > 0.05)
        ? 1.0
        : 0.0;
}

float dilated_occlusion_at(int x, int y) {
    float found = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            found = max(found, edge_at(x + dx, y + dy));
        }
    }
    return found;
}

float feathered_mask_at(int x, int y) {
    int radius = min(int(params.mask_feather_radius), 3);
    if (radius <= 0) {
        return dilated_occlusion_at(x, y);
    }
    float total = 0.0;
    float count = 0.0;
    for (int dy = -3; dy <= 3; ++dy) {
        for (int dx = -3; dx <= 3; ++dx) {
            if (abs(dx) <= radius && abs(dy) <= radius) {
                total += dilated_occlusion_at(x + dx, y + dy);
                count += 1.0;
            }
        }
    }
    return total / max(count, 1.0);
}

vec3 box_average(int x, int y, float eye_sign) {
    int radius = min(int(params.fill_radius), 3);
    vec3 total = vec3(0.0);
    float count = 0.0;
    for (int dy = -3; dy <= 3; ++dy) {
        for (int dx = -3; dx <= 3; ++dx) {
            if (abs(dx) <= radius && abs(dy) <= radius) {
                total += warp_at(x + dx, y + dy, eye_sign);
                count += 1.0;
            }
        }
    }
    return total / max(count, 1.0);
}

vec3 fill_eye(int x, int y, float eye_sign, float mask) {
    vec3 original = warp_at(x, y, eye_sign);
    vec3 blurred = box_average(x, y, eye_sign);
    float left_depth = depth_at(x - 1, y);
    float right_depth = depth_at(x + 1, y);
    vec3 directional = right_depth < left_depth
        ? warp_at(x - 1, y, eye_sign)
        : warp_at(x + 1, y, eye_sign);
    vec3 content_aware = directional * 0.75 + blurred * 0.25;
    float current_luma = dot(original, vec3(0.299, 0.587, 0.114));
    float left_luma = dot(warp_at(x - 1, y, eye_sign), vec3(0.299, 0.587, 0.114));
    float up_luma = dot(warp_at(x, y - 1, eye_sign), vec3(0.299, 0.587, 0.114));
    float protection = clamp((max(abs(current_luma - left_luma), abs(current_luma - up_luma)) - 0.20) / 0.30, 0.0, 1.0);
    float blend = clamp(mask * params.fill_strength * (1.0 - protection * 0.70), 0.0, 1.0);
    return mix(original, content_aware, blend);
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= params.width || y >= params.height) {
        return;
    }
    int ix = int(x);
    int iy = int(y);
    float mask = dilated_occlusion_at(ix, iy);
    float fill_mask = feathered_mask_at(ix, iy);
    uint pixel = pixel_index(ix, iy);
    uint plane = pixel_count();
    vec3 left = fill_eye(ix, iy, 1.0, fill_mask);
    float right_sign = params.symmetric != 0u ? -1.0 : -0.9;
    vec3 right = fill_eye(ix, iy, right_sign, fill_mask);
    left_eye[pixel] = left.r;
    left_eye[plane + pixel] = left.g;
    left_eye[2 * plane + pixel] = left.b;
    right_eye[pixel] = right.r;
    right_eye[plane + pixel] = right.g;
    right_eye[2 * plane + pixel] = right.b;
    occlusion_mask[pixel] = mask;
}
