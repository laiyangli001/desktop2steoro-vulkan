#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// The atlas is an RGBA8 storage image so the RGB MSDF channels remain raw
// distance data. Bilinear filtering is performed explicitly below.
layout(set = 0, binding = 0, rgba8) readonly uniform image2D msdf_atlas;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D quad_output;

struct Glyph {
    vec4 rect;  // output pixel x, y, width, height
    vec4 uv;    // atlas normalized u0, v0, u1, v1
    vec4 color; // display-referred RGBA in the sRGB domain
};

layout(set = 0, binding = 2, std430) readonly buffer GlyphBuffer {
    Glyph glyphs[];
};

layout(push_constant) uniform Params {
    uvec4 dimensions; // output width, output height, atlas width, atlas height
    uvec4 options;    // glyph count, output target is sRGB, reserved
    vec4 background;  // display-referred sRGB RGBA
    vec4 style;       // corner radius, distance range, reserved
} params;

float median3(vec3 value) {
    return max(min(value.r, value.g), min(max(value.r, value.g), value.b));
}

vec4 sampleMsdf(vec2 uv) {
    vec2 atlas_size = vec2(params.dimensions.zw);
    vec2 coordinate = clamp(uv, vec2(0.0), vec2(1.0)) * atlas_size - vec2(0.5);
    ivec2 p0 = ivec2(floor(coordinate));
    ivec2 p1 = p0 + ivec2(1);
    vec2 fraction = fract(coordinate);
    ivec2 limit = ivec2(params.dimensions.zw) - ivec2(1);
    p0 = clamp(p0, ivec2(0), limit);
    p1 = clamp(p1, ivec2(0), limit);
    vec4 a = imageLoad(msdf_atlas, p0);
    vec4 b = imageLoad(msdf_atlas, ivec2(p1.x, p0.y));
    vec4 c = imageLoad(msdf_atlas, ivec2(p0.x, p1.y));
    vec4 d = imageLoad(msdf_atlas, p1);
    return mix(mix(a, b, fraction.x), mix(c, d, fraction.x), fraction.y);
}

float srgbToLinear(float value) {
    value = max(value, 0.0);
    return value <= 0.04045
        ? value / 12.92
        : pow((value + 0.055) / 1.055, 2.4);
}

bool insideRoundedPanel(vec2 pixel, vec2 extent, float radius) {
    vec2 center = clamp(pixel, vec2(radius), extent - vec2(radius));
    return distance(pixel, center) <= radius;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(params.dimensions.x) || pixel.y >= int(params.dimensions.y)) {
        return;
    }

    vec2 output_extent = vec2(params.dimensions.xy);
    vec2 pixel_center = vec2(pixel) + vec2(0.5);
    vec4 result = vec4(0.0);
    if (insideRoundedPanel(pixel_center, output_extent, params.style.x)) {
        result = params.background;
    }

    uint glyph_count = params.options.x;
    for (uint index = 0u; index < glyph_count; ++index) {
        Glyph glyph = glyphs[index];
        vec2 local = pixel_center - glyph.rect.xy;
        if (local.x < 0.0 || local.y < 0.0
                || local.x >= glyph.rect.z || local.y >= glyph.rect.w) {
            continue;
        }
        vec2 glyph_uv = mix(glyph.uv.xy, glyph.uv.zw,
                            local / max(glyph.rect.zw, vec2(1.0)));
        float signed_distance = median3(sampleMsdf(glyph_uv).rgb);
        float screen_px_range = clamp(glyph.rect.w / max(params.style.y, 1.0), 1.0, 16.0);
        float coverage = clamp((signed_distance - 0.5) * screen_px_range + 0.5, 0.0, 1.0);
        float source_alpha = coverage * clamp(glyph.color.a, 0.0, 1.0);
        float output_alpha = source_alpha + result.a * (1.0 - source_alpha);
        if (output_alpha > 0.000001) {
            result.rgb = (glyph.color.rgb * source_alpha
                + result.rgb * result.a * (1.0 - source_alpha)) / output_alpha;
        }
        result.a = output_alpha;
    }

    // The intermediate image is UNORM. When the Quad swapchain is sRGB, the
    // already-composited display-referred color is linearized exactly once at
    // the copy boundary via the Vulkan UNORM -> sRGB blit conversion.
    vec3 output_rgb = result.rgb;
    if (params.options.y != 0u) {
        output_rgb = vec3(
            srgbToLinear(result.r),
            srgbToLinear(result.g),
            srgbToLinear(result.b)
        );
    }
    imageStore(
        quad_output,
        pixel,
        vec4(
            output_rgb,
            result.a
        )
    );
}
